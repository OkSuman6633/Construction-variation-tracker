APP_ENV=local
STORAGE_BACKEND=sqlite
AUDIT_BACKEND=sqlite
LOCAL_DATA_DIR=.local-data
AUTH_ISSUER=cvea-local
AUTH_AUDIENCE=cvea-local
AUTH_DEV_HS256_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
SCANNER_BACKEND=dev_noop
TASK_QUEUE_BACKEND=inline_thread
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace-with-your-server-side-gemini-api-key
