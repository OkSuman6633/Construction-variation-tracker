# Copy to backend/.env for local development. Never commit real values.
APP_ENV=local                      # local | test | dev | staging | production

# Storage: local/jsonl are DEV-ONLY adapters (refused in staging/production)
STORAGE_BACKEND=sqlite
LOCAL_DATA_DIR=.local-data
GCS_BUCKET=
AUDIT_BACKEND=sqlite                # production: bigquery
GCP_PROJECT=
BIGQUERY_DATASET=

# Auth. Production: set issuer/audience/JWKS of your identity provider.
AUTH_ISSUER=cvea-dev
AUTH_AUDIENCE=cvea-api
AUTH_JWKS_URL=
AUTH_DEV_HS256_SECRET=             # local/test only; must be unset in staging/production

# Gemini through Google ADK (backend only; never expose to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash                     # verify against your ADK version + API before use
GOOGLE_GENAI_USE_VERTEXAI=FALSE    # AI Studio = synthetic/dev data only (see assessment risk 1)

# Ingestion / processing
SCANNER_BACKEND=none               # none = files stay quarantined; dev_noop = local only, no scan
TASK_QUEUE_BACKEND=inline_thread   # local only; production: cloud_tasks
MAX_UPLOAD_BYTES=26214400
GCP_LOCATION=europe-west2
TASKS_QUEUE=
WORKER_URL=
TASK_SERVICE_ACCOUNT=
MAX_JOB_ATTEMPTS=3
JOB_TIMEOUT_SECONDS=900
